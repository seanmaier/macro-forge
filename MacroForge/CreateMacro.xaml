<Window x:Class="MacroForge.CreateMacro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MacroForge"
        mc:Ignorable="d"
        Title="CreateMacro" Height="700" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None"
        Background="Transparent" AllowsTransparency="True">
    <Border Background="#eff2f7" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <local:TitleBarControl Grid.ColumnSpan="2" />

            <StackPanel Grid.Row="1" Grid.Column="0">
                <Label Content="Name" />
                <Border
                    Padding="10" Grid.Row="1"
                    Background="AntiqueWhite"
                    Margin="10" BorderBrush="#D5B9B2"
                    BorderThickness="0 0 0 1"
                    CornerRadius="20">
                    <TextBox Background="Transparent" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1">
                <Label Content="Shortcut" />
                <Border
                    Padding="10" Grid.Row="1"
                    Background="AntiqueWhite"
                    Margin="10" BorderBrush="#D5B9B2"
                    BorderThickness="0 0 0 1"
                    CornerRadius="20">
                    <TextBox Background="Transparent" />
                </Border>
            </StackPanel>
            <StackPanel
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="2">
                <Label Content="Description" />
                <Border
                    Padding="10"
                    Background="AntiqueWhite"
                    Margin="10" BorderBrush="#D5B9B2"
                    BorderThickness="0 0 0 1"
                    CornerRadius="20">
                    <TextBox Background="Transparent" />
                </Border>
            </StackPanel>

            <StackPanel
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="3">
                <Label Content="Macro Steps" />
                <Border
                    Padding="10"
                    Background="AntiqueWhite"
                    Margin="10" BorderBrush="#D5B9B2"
                    BorderThickness="0 0 0 1"
                    CornerRadius="20">
                    <TextBox Background="Transparent" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>